[Unit]
Description=Nexra Bot Installer (Telegram)
After=network.target mysql.service

[Service]
Type=simple
WorkingDirectory=/root/nexra-installer
EnvironmentFile=/root/nexra-installer/env
ExecStart=/usr/bin/python3 /root/nexra-installer/bot.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
